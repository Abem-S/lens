# Copy to .env (gitignored) and fill in. Never commit .env.

# Muse Spark Open on Baseten (page reading, checking, hints, conversation)
BASETEN=
# Optional overrides
# SPARK_BASE_URL=https://inference.baseten.co/v1
# SPARK_MODEL=meta-models/muse-spark-open-1026
# USD per million tokens, for per-call cost logging (unset = cost logged as unknown).
# Third-party listing for this model, unconfirmed on Baseten's own pricing page: 1.25 in / 4.25 out.
SPARK_PRICE_IN_PER_M=
SPARK_PRICE_OUT_PER_M=

# Hugging Face token: FERMAT eval set (gated) and SAM 3.1 weights
HF_TOKEN=

# Modal (SAM 3.1, Omnilingual ASR, Kokoro)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Address phones use to reach the app, e.g. https://lens.example.com (QR pairing).
# Leave empty in local dev: the LAN address is used.
PUBLIC_URL=

# Set to 0 to run without the Modal services (no voice, no SAM outlines or pointing)
# LENS_USE_MODAL=1
