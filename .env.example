# Copy to .env (gitignored) and fill in. Never commit .env.

# Muse Spark Open on Baseten (page reading, checking, hints, conversation)
BASETEN=
# Optional overrides
# SPARK_BASE_URL=https://inference.baseten.co/v1
# SPARK_MODEL=meta-models/muse-spark-open-1026
# USD per million tokens, for per-call cost logging and the daily spend cap.
# ESTIMATE: a third-party listing for this model, not yet confirmed on Baseten's own pricing
# page. Unset or empty also means these defaults (1.25 in / 4.25 out).
SPARK_PRICE_IN_PER_M=1.25
SPARK_PRICE_OUT_PER_M=4.25

# Optional: self-hosted Muse Glimmer on Modal instead of Spark on Baseten
# (deploy with `make deploy-glimmer`). GLIMMER_API_KEY is any long random string;
# the server requires it as a bearer token. To switch the backend to Glimmer:
#   SPARK_API_KEY=<same value as GLIMMER_API_KEY>   (wins over BASETEN when set)
#   SPARK_BASE_URL=https://<workspace>--muna-lens-glimmer-serve.us-east.modal.run/v1
#   SPARK_MODEL=muse-glimmer
#   SPARK_PRICE_IN_PER_M=0 and SPARK_PRICE_OUT_PER_M=0 (paid per GPU-second on Modal instead)
GLIMMER_API_KEY=
SPARK_API_KEY=

# Hugging Face token: FERMAT eval set (gated) and SAM 3.1 weights
HF_TOKEN=

# Modal (SAM 3.1, Omnilingual ASR, Kokoro)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Address phones use to reach the app, e.g. https://lens.example.com (QR pairing).
# Leave empty in local dev: the LAN address is used.
PUBLIC_URL=

# Optional tester gate: testers open https://<host>/?code=<this> once (or type it on the
# locked page). Empty = open access. A phone pairs by QR without the code: the QR carries a
# pairing token that works for 15 minutes.
LENS_ACCESS_CODE=

# Rate limits and spend caps (the public link spends money). 0 = no limit. Defaults shown.
# Keep comments on their own lines: a value may not carry a trailing comment.
# Tutor sessions open at once, and live SAM 3.1 tracking sessions at once (GPU):
# LENS_MAX_SESSIONS=8
# LENS_MAX_TRACKING=4
# Session starts (tutor sockets + phone pairings) per IP per hour:
# LENS_SESSIONS_PER_IP_HOUR=40
# Page checks and spoken turns per session per minute:
# LENS_CHECKS_PER_MIN=6
# LENS_UTTERANCES_PER_MIN=20
# Spark calls and estimated Spark spend (from the prices above) per UTC day, everyone together:
# LENS_DAILY_SPARK_CALLS=4000
# LENS_DAILY_SPEND_USD=15
# GPU services only run while someone is using Lens: the browser rests them after this many
# minutes with no camera movement, speech or tap (and at once when the tab is hidden).
# LENS_IDLE_MIN=5
# One tracking socket at most this many minutes (the browser reconnects if still active):
# LENS_TRACK_MAX_MIN=45
# Estimated Modal GPU prices per hour, for the per-session cost tally in the logs:
# LENS_GPU_PRICE_L40S_PER_H=1.95
# LENS_GPU_PRICE_L4_PER_H=0.80

# Set to 0 to run without the Modal services (no voice, no SAM outlines or pointing)
# LENS_USE_MODAL=1

# Live SAM 3.1 tracking (modal_apps/sam31.py). Both optional: the URL is found through
# Modal, and the shared token is derived from MODAL_TOKEN_SECRET at deploy and at run time.
# LENS_TRACK_URL=
# LENS_TRACK_TOKEN=
